        <!-- Tab 1: Panel de Control (Dashboard) -->
        <section id="tab-dashboard" class="section-content active bg-white p-8 rounded-b-xl shadow-lg">
            <div class="mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-[#1E3A8A] mb-3">Panel de Control Global (Dashboard)</h2>
