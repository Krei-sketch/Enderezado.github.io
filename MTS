                        <p class="text-xs text-cyan-600/70 mt-1">=SUMA(Registro!F:F)</p>
                    </div>
                    <div class="bg-orange-50 p-6 rounded-xl border border-orange-200 shadow-sm transform transition hover:-translate-y-1">
                        <span class="text-xs font-bold text-[#F97316] uppercase tracking-wider">Saldo Pendiente</span>
