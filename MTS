            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-1">
                    <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 shadow-inner h-full">
                        <h3 class="font-bold text-[#1E3A8A] border-b border-gray-300 pb-2 mb-4">Resumen de Mermas</h3>
                        <ul class="space-y-4">
                            <li class="flex justify-between items-center">
                                <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#E11D48]"></span> Mantenimiento</span>
