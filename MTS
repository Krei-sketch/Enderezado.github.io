        </section>

    </main>

    <script>
        // --- 1. Global Utilities & Requirements ---
        
        // Requirement: Label wrapping (16-char logic)
        function wrapLabel(label) {
            if (typeof label !== 'string') return label;
            if (label.length <= 16) return label;
            const words = label.split(' ');
            let lines = [];
            let currentLine = '';
            words.forEach(word => {
                if ((currentLine + word).length > 16) {
                    if (currentLine.trim() !== '') lines.push(currentLine.trim());
                    currentLine = word + ' ';
                } else {
                    currentLine += word + ' ';
                }
            });
            if (currentLine.trim() !== '') lines.push(currentLine.trim());
            return lines;
        }

        // Requirement: Tooltip Configuration Object
        const customTooltipConfig = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    if (Array.isArray(label)) {
                        return label.join(' ');
                    } else {
                        return label;
                    }
                }
            }
        };

        // UI State Management (Tab Switching)
        function switchTab(tabId) {
            document.querySelectorAll('.section-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('active');
                el.classList.add('inactive');
            });
            
            document.getElementById(tabId).classList.add('active');
            const btn = document.getElementById('btn-' + tabId);
            btn.classList.remove('inactive');
            btn.classList.add('active');
        }

        // --- 2. Data State ---
        let currentDay = 4;
        const initialLogData = [
            { date: '01/05', machine: 'Inyectora 01', theor: 12.0, real: 10.5, cause: 'Mantenimiento', oee: 87.5 },
            { date: '01/05', machine: 'Prensa Hidr.', theor: 17.6, real: 16.0, cause: 'Operativo', oee: 90.9 },
            { date: '02/05', machine: 'Inyectora 01', theor: 12.0, real: 6.5, cause: 'Falta Material', oee: 54.1 },
            { date: '02/05', machine: 'Prensa Hidr.', theor: 17.6, real: 17.0, cause: 'Operativo', oee: 96.5 },
            { date: '03/05', machine: 'Inyectora 01', theor: 12.0, real: 11.0, cause: 'Operativo', oee: 91.6 },
            { date: '03/05', machine: 'Prensa Hidr.', theor: 17.6, real: 10.0, cause: 'Mantenimiento', oee: 56.8 },
        ];

        // Chart instances
        let chartInstances = {};

        // --- 3. Chart Initialization Functions ---

        function initDashboardChart() {
            const ctx = document.getElementById('chartDashboard').getContext('2d');
            const produced = 685;
            const remaining = 315;
            
            chartInstances.dashboard = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [wrapLabel('Tonelaje Producido'), wrapLabel('Saldo Pendiente a Producir')],
                    datasets: [{
                        data: [produced, remaining],
                        backgroundColor: ['#06B6D4', '#E2E8F0'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 20, font: { family: 'system-ui' } } },
                        tooltip: customTooltipConfig
                    }
                }
            });
        }

        function initConfigChart() {
            const ctx = document.getElementById('chartConfig').getContext('2d');
            const labels = ['Inyectora 01', 'Prensa Hidráulica', 'Extrusora A2'].map(wrapLabel);
            
            chartInstances.config = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tonelaje Teórico (100% OEE)',
                        data: [12.0, 17.6, 14.4],
                        backgroundColor: '#F97316',
                        borderRadius: 6,
                        barThickness: 'flex',
                        maxBarThickness: 50
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: customTooltipConfig
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#F1F5F9' }, title: { display: true, text: 'Toneladas por Día' } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        function getTrafficLightClass(oee) {
            if(oee >= 85) return 'bg-oee-green';
            if(oee >= 60) return 'bg-oee-yellow';
            return 'bg-oee-red';
        }

        function populateDailyTable() {
            const tbody = document.getElementById('dailyLogBody');
            tbody.innerHTML = '';
            
            // Reverse to show newest at top like a real log
            const displayData = [...initialLogData].reverse();
            
            displayData.forEach(row => {
                const isWarning = row.oee < 85;
                const tr = document.createElement('tr');
                tr.className = "border-b border-gray-100 hover:bg-gray-50 transition-colors";
                tr.innerHTML = `
                    <td class="p-3 font-medium">${row.date}</td>
                    <td class="p-3">${row.machine}</td>
                    <td class="p-3 text-center bg-gray-50">${row.theor.toFixed(1)}</td>
                    <td class="p-3 text-center font-bold text-[#1E3A8A]">${row.real.toFixed(1)}</td>
                    <td class="p-3">
                        ${isWarning ? `<span class="bg-red-50 text-red-700 px-2 py-1 rounded text-xs border border-red-200 font-medium">${row.cause}</span>` : '<span class="text-gray-300">-</span>'}
                    </td>
                    <td class="p-3 text-center">
                        <span class="inline-block w-full py-1 rounded font-bold text-sm ${getTrafficLightClass(row.oee)}">
                            ${row.oee.toFixed(1)}%
                        </span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function initRegistroChart() {
            const ctx = document.getElementById('chartRegistro').getContext('2d');
            
            // Transform data for line chart
            const labels = ['01/05', '02/05', '03/05'];
            const inyData = [87.5, 54.1, 91.6];
            const preData = [90.9, 96.5, 56.8];
            
            chartInstances.registro = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Inyectora 01',
                            data: inyData,
                            borderColor: '#06B6D4',
                            backgroundColor: '#06B6D4',
                            tension: 0.3,
                            borderWidth: 3,
                            pointRadius: 5
                        },
                        {
                            label: 'Prensa Hidr.',
                            data: preData,
                            borderColor: '#1E3A8A',
                            backgroundColor: '#1E3A8A',
                            tension: 0.3,
                            borderWidth: 3,
                            pointRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: customTooltipConfig,
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            max: 110,
                            grid: { color: '#F1F5F9' },
                            title: { display: true, text: 'OEE (%)' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function initAnalisisChart() {
            const ctx = document.getElementById('chartAnalisis').getContext('2d');
            const labels = ['Mantenimiento', 'Falta Material', 'Ajuste Máq.', 'Falta Op.'].map(wrapLabel);
            const frequencies = [14, 8, 5, 2];
            const total = frequencies.reduce((a,b)=>a+b,0);
            
            let cumulative = [];
            let currentSum = 0;
            frequencies.forEach(f => {
                currentSum += f;
                cumulative.push((currentSum/total)*100);
            });

            chartInstances.analisis = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: '% Acumulado',
                            data: cumulative,
                            borderColor: '#F97316',
                            backgroundColor: '#F97316',
                            borderWidth: 3,
                            yAxisID: 'y1',
                            tension: 0.2
                        },
                        {
                            type: 'bar',
                            label: 'Frecuencia (N° Incidentes)',
                            data: frequencies,
                            backgroundColor: '#1E3A8A',
                            borderRadius: 4,
                            yAxisID: 'y'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: customTooltipConfig,
                        legend: { position: 'top' }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { 
                            type: 'linear', 
                            display: true, 
                            position: 'left',
                            title: { display: true, text: 'Frecuencia' },
                            beginAtZero: true,
                            grid: { color: '#F1F5F9' }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: { display: true, text: '% Acumulado' },
                            max: 105,
                            beginAtZero: true,
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
        }

        // --- 4. Interactive Actions ---

        function simulateNewDay() {
            const dateStr = `0${currentDay}/05`;
            
            // Generate some semi-random data
            const inyReal = 6 + Math.random() * 6; // 6 to 12
            const preReal = 10 + Math.random() * 7; // 10 to 17

            const inyOEE = (inyReal / 12.0) * 100;
            const preOEE = (preReal / 17.6) * 100;

            const causes = ['Mantenimiento', 'Falta Material', 'Ajuste Máquina'];

            initialLogData.push({
                date: dateStr, machine: 'Inyectora 01', theor: 12.0, real: inyReal, 
                cause: inyOEE < 85 ? causes[Math.floor(Math.random()*causes.length)] : 'Operativo', 
                oee: inyOEE
            });
            initialLogData.push({
                date: dateStr, machine: 'Prensa Hidr.', theor: 17.6, real: preReal, 
                cause: preOEE < 85 ? causes[Math.floor(Math.random()*causes.length)] : 'Operativo', 
                oee: preOEE
            });

            // Update UI Table
            populateDailyTable();

            // Update Line Chart dynamically
            chartInstances.registro.data.labels.push(dateStr);
            chartInstances.registro.data.datasets[0].data.push(inyOEE);
            chartInstances.registro.data.datasets[1].data.push(preOEE);
            chartInstances.registro.update();

            currentDay++;
            
            // Add a small visual pulse effect to the button to show it worked
            const btn = document.querySelector('button[onclick="simulateNewDay()"]');
            btn.classList.add('ring-4', 'ring-orange-300');
            setTimeout(() => btn.classList.remove('ring-4', 'ring-orange-300'), 300);
        }

        // Initialize everything on load
        window.addEventListener('DOMContentLoaded', () => {
            initDashboardChart();
            initConfigChart();
            populateDailyTable();
            initRegistroChart();
            initAnalisisChart();
        });

    </script>
</body>
</html>
