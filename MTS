                            </thead>
                            <tbody class="text-gray-700">
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="p-4 font-semibold">Inyectora 01</td>
                                    <td class="p-4 text-center">1.5</td>
                                    <td class="p-4 text-center">8</td>
                                    <td class="p-4 text-center font-bold text-[#06B6D4] bg-cyan-50/30">12.0</td>
                                </tr>
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="p-4 font-semibold">Prensa Hidráulica</td>
                                    <td class="p-4 text-center">2.2</td>
                                    <td class="p-4 text-center">8</td>
                                    <td class="p-4 text-center font-bold text-[#06B6D4] bg-cyan-50/30">17.6</td>
                                </tr>
